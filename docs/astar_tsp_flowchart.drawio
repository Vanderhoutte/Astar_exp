    <diagram id="M5xK2nQ9pR7w" name="AStar-TSP-flow">
        <mxGraphModel dx="282" dy="348" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1800" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="480" y="40" width="120" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="输入 TSP 图 G、起点 s、启发函数 h&lt;br&gt;full_mask = (1 &amp;lt;&amp;lt; n) - 1&lt;br&gt;状态：(mask, current, phase)&lt;br&gt;phase=0 巡回；phase=1 闭合回起点&lt;br&gt;初始化 OPEN（最小堆按 f）、g_best、came_from&lt;br&gt;将 (mask={s}, current=s, phase=0, g=0) 入堆，f = g + ε·h" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="320" y="120" width="440" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="OPEN 为空？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="455" y="280" width="170" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="返回失败：无解" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="120" y="295" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="已超过&#10;时限？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="450" y="400" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="返回失败&#10;（超时或扩展上限）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="100" y="405" width="160" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="弹出 f 最小的状态&#10;(mask, current, phase, g)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="420" y="520" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="g 劣于&#10;g_best[state]？&#10;（陈旧节点）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="440" y="610" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="expansions 自增 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="460" y="730" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="expansions &gt;&#10;max_expansions？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="440" y="790" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="phase=1 且&#10;mask=full_mask 且&#10;current=start？&#10;（目标）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="430" y="910" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="沿 came_from 回溯得回路&#10;做合法性校验并返回闭合路径与代价 g&#10;（最优性由后续验证器认证）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="760" y="925" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="结束（成功）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="810" y="1030" width="120" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="15" value="phase=1？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="470" y="1050" width="140" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="mask 已访问&#10;全部城市？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1160" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="17" value="若存在边 current→start：&#10;new_g = g + w；状态 (full_mask, start, 1)&#10;若更优则更新 g_best、came_from 并入 OPEN" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="720" y="1155" width="320" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="18" value="对每个邻接 j：j≠start 且 j 未在 mask 中&lt;br&gt;new_mask = mask 按位或（1 左移 j 位），在 mask 中标记城市 j 已访问&lt;br&gt;（代码与项目实现一致：new_mask = mask | (1 &amp;lt;&amp;lt; j)）&lt;br&gt;new_g = g + w(i,j)；h = h(new_mask,j,…)；f = new_g + h&lt;br&gt;若 new_g 优于 g_best 则更新并入 OPEN" style="rounded=0;whiteSpace=wrap;html=1;align=center;spacingLeft=8;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="340" y="1290" width="400" height="120" as="geometry"/>
                </mxCell>
